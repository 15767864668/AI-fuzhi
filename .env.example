# 复制为 .env 后填写；也可以只在页面密码框中填写。
# 密钥不会写入项目包，请勿将 .env 提交到代码仓库。
MINIMAX_API_KEY=
H3_GPU_API_KEY=

# 本地项目和媒体目录；相对路径基于 app.py 所在目录。
HONGGUO_DATA_DIR=data
HONGGUO_PORT=7860
# 是否启动时自动打开浏览器：1 开启，0 关闭。
HONGGUO_OPEN_BROWSER=1

# 已安装在 PATH 时无需填写。Windows 示例：C:/ffmpeg/bin/ffmpeg.exe
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
